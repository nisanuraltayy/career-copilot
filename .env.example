# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.
# `.env` ASLA repoya commit edilmez (bkz. .gitignore).

# --- Veritabanı ---
DATABASE_URL=postgresql://raguser:ragpass123@localhost:5432/careerdb

# --- Gemini ---
GEMINI_API_KEY=buraya_kendi_anahtariniz
# Üretim modelleri PINLENMIŞTIR (kayan -latest alias'ı üretim için önerilmez).
# GEMINI_JSON_MODEL=gemini-2.5-flash
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# Bir model "high demand" (503) olduğunda sırayla denenecek yedek modeller:
# GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-flash-lite
# Serbest metin (mektup) çıktı tavanı ve istek timeout'u:
# GEMINI_TEXT_MAX_OUTPUT_TOKENS=1200
# GEMINI_REQUEST_TIMEOUT_MS=30000

# --- Auth / JWT (production'da MUTLAKA güçlü rastgele bir değer) ---
# Üret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me-in-prod

# --- Uygulama (opsiyonel; varsayılanlar app/core/config.py'de) ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# Virgülle ayrılmış CORS origin listesi
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# docker-compose için (isteğe bağlı override)
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass123
POSTGRES_DB=careerdb
